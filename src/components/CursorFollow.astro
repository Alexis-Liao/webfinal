<div id="cursor-dot" aria-hidden="true"></div>

<style is:global>
  #cursor-dot {
    position: fixed;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: rgba(168, 216, 188, 0.75);
    box-shadow: 0 0 0 1px rgba(117, 180, 169, 0.25);
    pointer-events: none;
    z-index: 9999;
    top: 0;
    left: 0;
    opacity: 0;
    transition: opacity 0.18s ease;
    will-change: transform;
  }
  #cursor-dot.is-visible { opacity: 1; }
  @media (prefers-reduced-motion: reduce), (hover: none), (pointer: coarse) {
    #cursor-dot { display: none; }
  }
</style>

<script>
  const dot = document.getElementById('cursor-dot');
  const enabled = window.matchMedia('(hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)');
  if (dot) {
    let frame = 0;
    let lastTime = 0;
    let visible = false;
    let x = 0, y = 0, targetX = 0, targetY = 0;

    const hide = () => {
      cancelAnimationFrame(frame);
      frame = 0;
      lastTime = 0;
      visible = false;
      dot.classList.remove('is-visible');
    };
    const draw = () => {
      dot.style.transform = `translate3d(${x}px, ${y}px, 0) translate(-50%, -50%)`;
    };
    const tick = (time: number) => {
      // Time-based easing keeps the same feel on 60 Hz and 120 Hz displays.
      const dt = lastTime ? Math.min(time - lastTime, 64) : 16;
      lastTime = time;
      const ease = 1 - Math.exp(-dt / 42);
      x += (targetX - x) * ease;
      y += (targetY - y) * ease;
      if (Math.hypot(targetX - x, targetY - y) < 0.1) {
        x = targetX;
        y = targetY;
        frame = 0;
        lastTime = 0;
      } else {
        frame = requestAnimationFrame(tick);
      }
      draw();
    };
    window.addEventListener('pointermove', (event: PointerEvent) => {
      if (!enabled.matches || event.pointerType !== 'mouse' || document.hidden) return;
      targetX = event.clientX;
      targetY = event.clientY;
      if (!visible) {
        // Re-enter at the pointer, without flying in from the last location.
        x = targetX;
        y = targetY;
        draw();
        dot.classList.add('is-visible');
        visible = true;
      }
      if (!frame) frame = requestAnimationFrame(tick);
    }, { passive: true });
    document.documentElement.addEventListener('pointerleave', hide);
    window.addEventListener('blur', hide);
    document.addEventListener('visibilitychange', hide);
    enabled.addEventListener('change', hide);
  }
</script>
