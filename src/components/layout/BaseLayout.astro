---
import MyceliumBackground from '../MyceliumBackground.astro';
import CursorFollow from '../CursorFollow.astro';
import SiteHeader from '../SiteHeader.astro';
import SiteFooter from '../SiteFooter.astro';
import '../../styles/global.css';

interface Props {
  title: string;
  description?: string;
  /** 'full' | 'subtle' | 'none' for mycelium */
  mycelium?: 'full' | 'subtle' | 'none';
  /** Extra class for main */
  class?: string;
}

const { title, description = 'Personal site — research, writing, projects.', mycelium = 'full', class: className = '' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <script is:inline>
      document.documentElement.classList.add('js-reveal');
    </script>
  </head>
  <body>
    <CursorFollow />
    <MyceliumBackground intensity={mycelium} />
    <SiteHeader />
    <main class={`main ${className}`}>
      <slot />
    </main>
    <SiteFooter />
    <!-- 同步：立刻显示首屏内容，避免模块脚本加载前的空页 -->
    <script is:inline>
      (function () {
        var items = document.querySelectorAll('.reveal-item');
        if (!items.length) return;
        var vh = window.innerHeight || document.documentElement.clientHeight;
        for (var i = 0; i < items.length; i++) {
          var r = items[i].getBoundingClientRect();
          if (r.top < vh - 24 && r.bottom > 0) {
            items[i].classList.add('is-visible');
          }
        }
      })();
    </script>
  </body>
  <script>
    const revealItems = document.querySelectorAll('.reveal-item');
    if (revealItems.length) {
      const markVisible = (el: Element) => {
        el.classList.add('is-visible');
      };

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              markVisible(entry.target);
              observer.unobserve(entry.target);
            }
          });
        },
        { rootMargin: '0px 0px -5% 0px', threshold: 0 }
      );

      revealItems.forEach((el) => {
        if (el.classList.contains('is-visible')) return;
        observer.observe(el);
      });

      // 兜底：避免 observer 异常时内容永久隐藏
      window.setTimeout(() => {
        revealItems.forEach((el) => {
          if (!el.classList.contains('is-visible')) markVisible(el);
        });
      }, 1800);
    }
  </script>
</html>

<style is:global>
  .main {
    position: relative;
    z-index: 1;
    min-height: calc(100vh - 5rem);
    padding: 2rem 0 4rem;
  }
</style>
