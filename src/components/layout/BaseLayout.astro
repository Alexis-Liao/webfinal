---
import MyceliumBackground from '../MyceliumBackground.astro';
import CursorFollow from '../CursorFollow.astro';
import SiteHeader from '../SiteHeader.astro';
import SiteFooter from '../SiteFooter.astro';
import '../../styles/global.css';

interface Props {
  title: string;
  description?: string;
  /** 'full' | 'subtle' | 'none' for mycelium */
  mycelium?: 'full' | 'subtle' | 'none';
  /** Extra class for main */
  class?: string;
}

const { title, description = 'Personal site — research, writing, projects.', mycelium = 'full', class: className = '' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <title>{title}</title>
  </head>
  <body>
    <CursorFollow />
    <MyceliumBackground intensity={mycelium} />
    <SiteHeader />
    <main class={`main ${className}`}>
      <slot />
    </main>
    <SiteFooter />
    <script>
      const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
      const items = Array.from(document.querySelectorAll<HTMLElement>('.reveal-item'));
      let observer: IntersectionObserver | undefined;
      const showAll = () => {
        observer?.disconnect();
        items.forEach((item) => {
          item.classList.add('is-visible');
          item.removeAttribute('data-reveal-pending');
        });
      };

      // Content stays readable if JS or observer setup fails. Only hide items
      // below the viewport after an observer has successfully attached.
      if (!motion.matches && 'IntersectionObserver' in window) {
        try {
          observer = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add('is-visible');
              observer?.unobserve(entry.target);
            });
          }, { rootMargin: '0px 0px -24px 0px', threshold: 0 });
          const viewport = window.innerHeight;
          const positions = items.map((item) => item.getBoundingClientRect().top);
          items.forEach((item, index) => {
            if (positions[index] < viewport) {
              item.classList.add('is-visible');
            } else {
              observer!.observe(item);
              item.setAttribute('data-reveal-pending', '');
            }
          });
        } catch {
          showAll();
        }
      }
      motion.addEventListener('change', () => { if (motion.matches) showAll(); });
      const updateVisibility = () => {
        document.documentElement.classList.toggle('motion-paused', document.hidden);
      };
      updateVisibility();
      document.addEventListener('visibilitychange', updateVisibility);
    </script>
  </body>
</html>

<style is:global>
  .main {
    position: relative;
    z-index: 1;
    min-height: calc(100vh - 5rem);
    padding: 2rem 0 4rem;
  }
</style>
