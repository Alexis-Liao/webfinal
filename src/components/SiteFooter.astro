---
<footer class="site-footer" id="contact">
  <div class="site-footer-overlay">
    <div class="container contact-container">
      <section class="contact-content">
        <h2 class="contact-heading">Contact</h2>
        <ul class="contact-links">
          <li><span class="contact-label">Email：</span><a href="mailto:alexisprotopia@gmail.com">alexisprotopia@gmail.com</a></li>
          <li><span class="contact-label">微信公众号：</span><a href="https://mp.weixin.qq.com/s/sO-pa_9-Ccq2rV4cnp8H8A" target="_blank" rel="noopener noreferrer">河与树</a></li>
          <li><span class="contact-label">Instagram：</span><a href="https://instagram.com/alexisprotopia" target="_blank" rel="noopener noreferrer">alexisprotopia</a></li>
          <li><span class="contact-label">小红书：</span><a href="https://www.xiaohongshu.com/search_result?keyword=Alexis智立" target="_blank" rel="noopener noreferrer">@Alexis智立</a></li>
        </ul>
      </section>
    </div>
  </div>
  <div class="contact-branding-layer" aria-hidden="true">
    <div class="container contact-branding-wrap">
      <div class="contact-branding">
        <img class="contact-logo" src="/logo.png" alt="" width="32" height="32" />
        <img class="contact-river-tree" src="/river-and-tree.png" alt="河与树 RIVER AND TREE" />
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    z-index: 1;
    margin-top: auto;
    width: 100%;
  }
  .contact-branding-layer {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    z-index: 2;
    display: flex;
    align-items: flex-end;
    justify-content: flex-start;
    pointer-events: none;
  }
  .contact-branding-wrap {
    display: flex;
    align-items: flex-end;
    justify-content: flex-start;
    pointer-events: auto;
  }
  .contact-branding {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
  }
  .contact-logo {
    display: block;
    height: 1.75rem;
    width: auto;
  }
  .contact-river-tree {
    display: block;
    height: 4rem;
    width: auto;
    max-width: 20rem;
    object-fit: contain;
    object-position: left bottom;
    mix-blend-mode: lighten;
  }
  @media (prefers-color-scheme: dark) {
    .contact-river-tree {
      mix-blend-mode: lighten;
    }
  }
  .site-footer-overlay {
    position: relative;
    width: 100%;
    background: rgba(255, 255, 255, 0.78);
    padding: 2.5rem 0;
    border-top: 1px solid var(--color-mist);
  }
  @media (prefers-color-scheme: dark) {
    .site-footer-overlay {
      background: rgba(34, 40, 38, 0.85);
    }
  }
  .contact-container {
    display: flex;
    align-items: flex-end;
    justify-content: flex-end;
    gap: 2rem;
    flex-wrap: wrap;
  }
  .contact-content {
    padding: 0;
    line-height: 1.75;
    max-width: 28rem;
    text-align: right;
  }
  .contact-heading {
    font-size: 1.25rem;
    font-weight: 600;
    margin: 0 0 0.75rem;
    color: var(--color-text);
  }
  .contact-links {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .contact-links li {
    margin-bottom: 0.35rem;
  }
  .contact-label {
    font-size: 0.9rem;
    color: var(--color-text-soft);
    margin-right: 0.4rem;
  }
  .contact-links a {
    display: inline;
    padding: 0;
    color: var(--color-accent);
    text-decoration: none;
    font-size: 1rem;
    line-height: 1.6;
    transition: color 0.2s ease, text-decoration-color 0.2s ease;
  }
  .contact-links a:hover {
    color: var(--color-accent-hover);
    text-decoration: underline;
    text-decoration-color: rgba(61, 107, 94, 0.4);
  }
  @media (max-width: 768px) {
    .site-footer-overlay {
      padding: 2rem 0;
    }
    .contact-river-tree {
      height: 3rem;
      max-width: 14rem;
    }
    .contact-container {
      flex-direction: column;
      align-items: flex-start;
    }
    .contact-content {
      text-align: left;
      max-width: 100%;
    }
  }
</style>
