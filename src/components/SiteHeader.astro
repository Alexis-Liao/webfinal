---
const current = Astro.url.pathname;
const nav = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/writing', label: 'Writings' },
  { href: '/projects', label: 'Projects' },
  { href: '/activities', label: 'Activities' },
  { href: '/resources', label: 'Resources' },
];
---

<header class="site-header">
  <nav class="nav container" aria-label="Main">
    <div class="nav-left">
      <a class="nav-home" href="/" aria-label="Alexis 智立 — Home">
        <img class="nav-home-logo" src="/river-and-tree.png" alt="河与树 RIVER AND TREE" />
      </a>
      <ul class="nav-links">
        {nav.filter((n) => n.href !== '/').map((n) => (
          <li>
            <a
              href={n.href}
              class:list={[current === n.href || (n.href !== '/' && current.startsWith(n.href)) && 'active']}
            >
              {n.label}
            </a>
          </li>
        ))}
      </ul>
    </div>
    <a class="nav-logo" href="#contact" aria-label="Contact">
      <img src="/logo.png" alt="" width="32" height="32" />
    </a>
  </nav>
</header>

<style>
  .site-header {
    position: relative;
    z-index: 1;
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--color-mist);
  }
  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .nav-left {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 2.25rem;
  }
  .nav-logo {
    display: block;
    line-height: 0;
  }
  .nav-logo img {
    height: 1.75rem;
    width: auto;
    display: block;
  }
  .nav-home {
    display: block;
    line-height: 0;
    width: 9rem;
    height: 2.5rem;
    overflow: hidden;
  }
  .nav-home:hover {
    opacity: 0.85;
  }
  .nav-home-logo {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    object-position: center;
    mix-blend-mode: lighten;
  }
  @media (prefers-color-scheme: dark) {
    .nav-home-logo {
      mix-blend-mode: lighten;
    }
  }
  .nav-links {
    display: flex;
    list-style: none;
    margin: 0;
    padding: 0;
    gap: 2.25rem;
  }
  .nav-links a {
    color: var(--color-text-muted);
    font-size: 0.9375rem;
    padding: 0.35rem 0.75rem;
    border-radius: 9999px;
    text-decoration: none;
    transition: color 0.2s ease, background-color 0.2s ease;
  }
  .nav-links a:hover {
    color: #fff;
    background-color: var(--color-accent);
    text-decoration: none;
  }
  .nav-links a.active {
    color: #fff;
    background-color: var(--color-accent);
    font-weight: 500;
  }
  .nav-links a.active:hover {
    background-color: var(--color-accent-hover);
  }
  @media (max-width: 768px) {
    .site-header {
      padding: 1rem 0;
      min-width: 0;
    }
    .nav {
      gap: 0.75rem;
      min-width: 0;
    }
    .nav-left {
      gap: 1.25rem;
      min-width: 0;
    }
    .nav-links {
      gap: 1.25rem;
      flex-wrap: wrap;
    }
  }
</style>
