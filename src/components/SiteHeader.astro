---
const current = Astro.url.pathname;
const nav = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/writing', label: 'Writings' },
  { href: '/projects', label: 'Projects' },
  { href: '/activities', label: 'Activities' },
  { href: '/resources', label: 'Resources' },
];
---

<header class="site-header">
  <nav class="nav container" aria-label="Main">
    <div class="nav-left">
      <div class="nav-brand">
        <a class="nav-home" href="/" aria-label="Alexis 智立 — Home">
          <img class="nav-home-logo" src="/river-and-tree.png" alt="河与树 RIVER AND TREE" />
        </a>
        <a class="nav-logo" href="#contact" aria-label="Contact">
          <img src="/logo.png" alt="" width="32" height="32" />
        </a>
      </div>
      <ul class="nav-links">
        {nav.filter((n) => n.href !== '/').map((n) => (
          <li>
            <a
              href={n.href}
              class:list={[current === n.href || (n.href !== '/' && current.startsWith(n.href)) && 'active']}
            >
              {n.label}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </nav>
</header>

<style>
  .site-header {
    position: relative;
    z-index: 1;
    padding: 1.75rem 0 1.25rem;
    border-bottom: 1px solid var(--color-mist);
  }
  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .nav-left {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 2.25rem;
    width: 100%;
  }
  .nav-brand {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .nav-logo {
    display: block;
    line-height: 0;
    flex-shrink: 0;
  }
  .nav-logo img {
    height: 1.75rem;
    width: auto;
    display: block;
  }
  .nav-home {
    display: block;
    line-height: 0;
    width: 9rem;
    height: 2.5rem;
    overflow: hidden;
  }
  .nav-home:hover {
    opacity: 0.85;
  }
  .nav-home-logo {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    object-position: center;
    mix-blend-mode: lighten;
  }
  @media (prefers-color-scheme: dark) {
    .nav-home-logo {
      mix-blend-mode: lighten;
    }
  }
  .nav-links {
    display: flex;
    list-style: none;
    margin: 0;
    padding: 0;
    gap: 2.25rem;
    margin-left: auto;
  }
  .nav-links a {
    position: relative;
    color: var(--color-text-muted);
    font-size: 0.9375rem;
    padding: 0.35rem 0;
    text-decoration: none;
    transition: color 0.25s ease;
  }
  .nav-links a::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 0;
    width: 100%;
    height: 1px;
    background: var(--color-accent);
    transform: translateX(-50%) scaleX(0);
    transform-origin: center;
    transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
    pointer-events: none;
  }
  .nav-links a:hover {
    color: var(--color-text);
    text-decoration: none;
  }
  .nav-links a:hover::after,
  .nav-links a.active::after {
    transform: translateX(-50%) scaleX(1);
  }
  .nav-links a.active {
    color: var(--color-text);
    font-weight: 500;
  }
  @media (prefers-reduced-motion: reduce) {
    .nav-links a::after {
      transition: none;
    }
  }
  @media (max-width: 900px) {
    .site-header {
      padding: 1.25rem 0 0.75rem;
      min-width: 0;
    }
    .nav {
      gap: 0;
      min-width: 0;
    }
    .nav-left {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      min-width: 0;
      width: 100%;
    }
    .nav-brand {
      flex-shrink: 0;
    }
    .nav-logo {
      display: none;
    }
    .nav-home {
      width: 5.5rem;
      height: 1.6rem;
      flex-shrink: 0;
    }
    .nav-links {
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      width: 100%;
      margin-left: 0;
      margin-top: 0.5rem;
      padding-top: 0.5rem;
      border-top: 1px solid var(--color-mist);
      gap: 0.25rem;
      flex-shrink: 0;
      min-width: 0;
      text-align: right;
    }
    .nav-links li {
      display: block;
      width: fit-content;
    }
    .nav-links a {
      display: block;
      padding: 0.35rem 0;
      font-size: 0.875rem;
    }
    .nav-links a::after {
      left: auto;
      right: 0;
      transform: scaleX(0);
      transform-origin: right center;
    }
    .nav-links a:hover::after,
    .nav-links a.active::after {
      transform: scaleX(1);
    }
  }
</style>
