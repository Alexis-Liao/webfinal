---
/**
 * Mycelium background: thin line network as structural metaphor.
 * Build-time generated SVG, no biological imagery. Low contrast, optional subtle motion.
 */
interface Props {
  /** 'full' | 'subtle' | 'none'. Writing pages may use 'none' or 'subtle'. */
  intensity?: 'full' | 'subtle' | 'none';
  /** Optional class for wrapper */
  class?: string;
}

const { intensity = 'full', class: className = '' } = Astro.props;

if (intensity === 'none') {
  // No output
}

// Deterministic pseudo-random for reproducible networks
function seeded(seed: number) {
  return () => {
    seed = (seed * 9301 + 49297) % 233280;
    return seed / 233280;
  };
}
const rnd = seeded(42);

interface Point {
  x: number;
  y: number;
  id: number;
}

const width = 1200;
const height = 800;
const numPoints = intensity === 'full' ? 55 : 28;
const jitter = 35;
const connectRadius = 140;
const maxConnections = 4;

const points: Point[] = [];
// Non-uniform grid with jitter
const cols = 8;
const rows = Math.ceil(numPoints / cols);
for (let i = 0; i < numPoints; i++) {
  const col = i % cols;
  const row = Math.floor(i / cols);
  const baseX = (col + 0.5) * (width / cols);
  const baseY = (row + 0.5) * (height / rows);
  points.push({
    x: baseX + (rnd() - 0.5) * jitter * 2,
    y: baseY + (rnd() - 0.5) * jitter * 2,
    id: i,
  });
}

// Build edges: each point connects to up to maxConnections nearest neighbors
const edges: { x1: number; y1: number; x2: number; y2: number }[] = [];
const seen = new Set<string>();
function edgeKey(a: number, b: number) {
  return a < b ? `${a}-${b}` : `${b}-${a}`;
}
for (const p of points) {
  const dists = points
    .filter((q) => q.id !== p.id)
    .map((q) => ({
      q,
      d: (p.x - q.x) ** 2 + (p.y - q.y) ** 2,
    }))
    .sort((a, b) => a.d - b.d);
  let count = 0;
  for (const { q } of dists) {
    if (count >= maxConnections) break;
    if (q.x - p.x > connectRadius || p.x - q.x > connectRadius) continue;
    if (q.y - p.y > connectRadius || p.y - q.y > connectRadius) continue;
    const key = edgeKey(p.id, q.id);
    if (seen.has(key)) continue;
    seen.add(key);
    edges.push({ x1: p.x, y1: p.y, x2: q.x, y2: q.y });
    count++;
  }
}

const strokeOpacity = intensity === 'full' ? 0.07 : 0.04;
const strokeWidth = 0.6;
---

{intensity !== 'none' && (
  <div class={`mycelium-wrap ${className}`} aria-hidden="true">
    <svg
      class="mycelium-svg"
      xmlns="http://www.w3.org/2000/svg"
      viewBox={`0 0 ${width} ${height}`}
      preserveAspectRatio="xMidYMid slice"
      focusable="false"
    >
      {[0, 1, 2].map((group) => (
        <g class="mycelium-strand" style={`--phase: ${group * -5}s`}>
          {edges.filter((_, index) => index % 3 === group).map((edge) => (
            <line
              x1={edge.x1} y1={edge.y1} x2={edge.x2} y2={edge.y2}
              stroke="var(--mycelium-ink)"
              stroke-width={strokeWidth}
              stroke-opacity={strokeOpacity}
              vector-effect="non-scaling-stroke"
            />
          ))}
          {points.filter((point) => point.id % 7 === 0 && point.id % 3 === group).map((point) => (
            <circle cx={point.x} cy={point.y} r="1.8" fill="var(--mycelium-ink)" fill-opacity={strokeOpacity * 1.8} />
          ))}
        </g>
      ))}
    </svg>
  </div>
)}

<style>
  .mycelium-wrap {
    --mycelium-ink: #2d5a5a;
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    overflow: hidden;
  }
  .mycelium-svg {
    width: 100%;
    height: 100%;
    opacity: 0.75;
  }
  @media (prefers-color-scheme: dark) {
    .mycelium-wrap { --mycelium-ink: #b4c8c3; }
  }
  /* Three slow strands replace per-line dash painting across the viewport. */
  @media (prefers-reduced-motion: no-preference) {
    .mycelium-svg {
      animation: mycelium-drift 32s ease-in-out infinite;
    }
    .mycelium-strand {
      animation: mycelium-breathe 15s ease-in-out infinite;
      animation-delay: var(--phase);
    }
  }
  :global(html.motion-paused) .mycelium-svg,
  :global(html.motion-paused) .mycelium-strand {
    animation-play-state: paused;
  }
  @keyframes mycelium-breathe {
    0%, 100% { opacity: 0.45; }
    50% { opacity: 1; }
  }
  @keyframes mycelium-drift {
    0%, 100% { transform: scale(1.03) translate3d(-3px, 0, 0); }
    50% { transform: scale(1.03) translate3d(3px, -6px, 0); }
  }
</style>
