---
import BaseLayout from '../../components/layout/BaseLayout.astro';
import { getWritingPosts } from '../../data/writing';
import { externalArticles } from '../../data/externalArticles';
import { forthcomingArticles } from '../../data/forthcomingArticles';
import WritingLayout from '../../layouts/WritingLayout.astro';

export async function getStaticPaths() {
  const mdPosts = await getWritingPosts();

  const mdPaths = mdPosts.map((post) => ({
    params: { slug: post.slug },
    props: { type: 'content' as const, postId: post.id },
  }));

  const externalPaths = externalArticles.map((article) => ({
    params: { slug: article.slug },
    props: { type: 'external' as const, slug: article.slug },
  }));

  const forthcomingPaths = forthcomingArticles.map((article) => ({
    params: { slug: article.slug },
    props: { type: 'forthcoming' as const, slug: article.slug },
  }));

  return [...mdPaths, ...externalPaths, ...forthcomingPaths];
}

type Props =
  | { type: 'content'; postId: string }
  | { type: 'external'; slug: string }
  | { type: 'forthcoming'; slug: string };

const props = Astro.props as Props;
const mdPosts = await getWritingPosts();
const contentPost = props.type === 'content' ? mdPosts.find((p) => p.id === props.postId) : null;
const contentRender = contentPost ? await contentPost.render() : null;
const Content = contentRender?.Content ?? null;
---

{props.type === 'content' && (contentPost && Content ? (
  <WritingLayout
    title={contentPost.data.title}
    description={contentPost.data.description}
    pubDate={contentPost.data.pubDate ? new Date(contentPost.data.pubDate) : undefined}
  >
    <Content />
    <p class="back-link">
      <a href="/writing">← Back to Writings</a>
    </p>
  </WritingLayout>
) : (
  <BaseLayout title="Not found" mycelium="none">
    <div class="container reading">
      <p>Article not found.</p>
    </div>
  </BaseLayout>
))}

{props.type === 'external' && (() => {
  const article = externalArticles.find((a) => a.slug === props.slug);
  if (!article) return (
    <BaseLayout title="Not found" mycelium="none">
      <div class="container reading">
        <p>Article not found.</p>
      </div>
    </BaseLayout>
  );

  return (
    <WritingLayout
      title={article.title}
      description={article.sourceLine}
    >
      <div class="container reading">
        {article.titleEn && <p class="article-meta" lang="en">{article.titleEn}</p>}
        {article.sourceLine && (
          <p class="article-meta">{article.sourceLine}</p>
        )}
        {article.image && (
          <figure class="article-full-image">
            <img src={article.image} alt={article.title} style={article.imagePosition ? { objectPosition: article.imagePosition } : undefined} />
          </figure>
        )}
        {article.publicationNoteZh && <p lang="zh">{article.publicationNoteZh}</p>}
        {article.publicationNoteEn && <p lang="en">{article.publicationNoteEn}</p>}
        {article.url ? (
        <p class="read-full-cta">
          <a href={article.url} target="_blank" rel="noopener noreferrer">
            <span lang="zh">{article.linkLabelZh ?? '阅读完整内容请点击这里'}</span>
            <span class="read-full-cta-en" lang="en">{article.linkLabelEn ?? 'Click here to read the full content'}</span>
          </a>
        </p>
        ) : (
          <p class="article-placeholder-body" lang="zh">内容整理中，敬请期待。欢迎通过页脚联系方式与我交流。</p>
        )}
        <p class="back-link">
          <a href="/writing">← Back to Writings</a>
        </p>
      </div>
    </WritingLayout>
  );
})()}

{props.type === 'forthcoming' && (() => {
  const article = forthcomingArticles.find((a) => a.slug === props.slug);
  if (!article) return (
    <BaseLayout title="Not found" mycelium="none">
      <div class="container reading">
        <p>Article not found.</p>
      </div>
    </BaseLayout>
  );

  return (
    <WritingLayout
      title={article.titleZh}
      description={article.titleEn}
    >
      <div class="container reading">
        <p class="article-meta">{article.status}</p>
        <p>{article.titleEn}</p>
        {article.articleImage && (
          <figure class="article-full-image">
            <img src={article.articleImage} alt="706 余烬派对 Ember Camp" />
          </figure>
        )}
        {article.placeholderBody ? (
          <p class="article-placeholder-body">{article.placeholderBody}</p>
        ) : (
          <p class="article-placeholder-body" lang="zh">本文待刊出，完整内容将在发表后提供。</p>
        )}
        {article.placeholderBodyEn && <p class="article-placeholder-body" lang="en">{article.placeholderBodyEn}</p>}
        <p class="back-link">
          <a href="/writing">← Back to Writings</a>
        </p>
      </div>
    </WritingLayout>
  );
})()}

<style>
  .article-meta {
    font-size: 0.875rem;
    color: var(--color-text-soft);
    margin-bottom: 1.5rem;
  }
  .article-full-image {
    margin: 1.5rem 0;
  }
  .article-full-image img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 6px;
  }
  .article-placeholder-body {
    line-height: 1.7;
    margin-top: 1rem;
    color: var(--color-text);
  }
  .back-link {
    margin-top: 3rem;
    font-size: 0.9rem;
  }
  .back-link a {
    color: var(--color-text-soft);
  }
  .back-link a:hover {
    color: var(--color-accent);
  }
</style>

