---
import BaseLayout from '../../components/layout/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { externalArticles } from '../../data/externalArticles';
import { forthcomingArticles } from '../../data/forthcomingArticles';

const posts = (await getCollection('writing')).sort(
  (a, b) => new Date(b.data.pubDate ?? 0).getTime() - new Date(a.data.pubDate ?? 0).getTime()
);

type CardItem = {
  title: string;
  subtitle?: string;
  meta?: string;
  href: string;
  image?: string;
  imagePosition?: string;
};

const cards: CardItem[] = [
  ...externalArticles.map((a) => ({
    title: a.title,
    subtitle: a.titleEn,
    meta: a.sourceLine,
    href: `/writing/${a.slug}`,
    image: a.image,
    imagePosition: a.imagePosition,
  })),
  ...forthcomingArticles.map((a) => ({
    title: a.titleZh,
    subtitle: a.titleEn,
    meta: a.status,
    href: `/writing/${a.slug}`,
    image: a.image,
    imagePosition: a.imagePosition,
  })),
  ...posts.map((p) => ({
    title: p.data.title,
    subtitle: p.data.pubDate
      ? new Date(p.data.pubDate).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })
      : p.data.description,
    meta: undefined,
    href: `/writing/${p.slug}`,
    image: undefined,
    imagePosition: undefined,
  })),
];
---

<BaseLayout
  title="Writings"
  description="Essays and notes."
  mycelium="subtle"
>
  <header class="writing-index-header container">
    <h1>Writings</h1>
  </header>
  <div class="writing-cards container">
    {cards.map((card) => (
      <a href={card.href} class="writing-card">
        <div class="writing-card-text">
          <span class="writing-card-title">{card.title}</span>
          {card.subtitle && <span class="writing-card-subtitle">{card.subtitle}</span>}
          {card.meta && <span class="writing-card-meta">{card.meta}</span>}
        </div>
        <div class="writing-card-image-wrap">
          {card.image ? (
            <img
              src={card.image}
              alt=""
              class="writing-card-image"
              style={card.imagePosition ? { objectPosition: card.imagePosition } : undefined}
            />
          ) : (
            <div class="writing-card-image-placeholder" aria-hidden="true" />
          )}
        </div>
      </a>
    ))}
  </div>
</BaseLayout>

<style>
  .writing-index-header {
    margin-bottom: 1.5rem;
  }
  .writing-index-header h1 {
    margin-bottom: 0.5rem;
  }
  .writing-cards {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.25rem;
    padding-bottom: 2rem;
  }
  .writing-card {
    display: flex;
    flex-direction: column;
    background: var(--panel-wash);
    border: 1px solid color-mix(in srgb, var(--color-mist) 70%, transparent);
    border-radius: 2px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    transition:
      border-color 0.3s ease,
      transform 0.35s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.35s ease;
  }
  .writing-card:hover {
    border-color: color-mix(in srgb, var(--color-rain-tree) 45%, var(--color-mist));
    box-shadow: 0 10px 28px rgba(36, 48, 44, 0.07);
    transform: translateY(-2px);
    text-decoration: none;
  }
  .writing-card-text {
    padding: 1.05rem 1.05rem 0.85rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    flex: 0 0 auto;
    box-sizing: border-box;
    background: transparent;
  }
  @media (prefers-color-scheme: dark) {
    .writing-card-text {
      background: transparent;
    }
  }
  .writing-card-title {
    font-weight: 600;
    font-size: 0.95rem;
    line-height: 1.4;
    color: var(--color-text);
  }
  .writing-card-subtitle {
    font-size: 0.8rem;
    color: var(--color-text-soft);
    line-height: 1.45;
  }
  .writing-card-meta {
    font-size: 0.72rem;
    color: var(--color-glacier);
    margin-top: 0.2rem;
    letter-spacing: 0.02em;
  }
  .writing-card-image-wrap {
    width: 100%;
    aspect-ratio: 4 / 3;
    flex: 1 1 auto;
    min-height: 0;
    background: var(--color-mist);
    overflow: hidden;
  }
  .writing-card-image {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    object-position: center;
    transition: transform 0.55s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .writing-card:hover .writing-card-image {
    transform: scale(1.03);
  }
  .writing-card-image-placeholder {
    width: 100%;
    height: 100%;
    background:
      linear-gradient(
        145deg,
        var(--color-glacier-soft) 0%,
        var(--color-rain-tree-soft) 100%
      );
  }
  @media (prefers-reduced-motion: reduce) {
    .writing-card,
    .writing-card-image {
      transition: none;
    }
    .writing-card:hover {
      transform: none;
    }
    .writing-card:hover .writing-card-image {
      transform: none;
    }
  }
  @media (max-width: 1024px) {
    .writing-cards {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 768px) {
    .writing-index-header {
      margin-bottom: 1.25rem;
    }
    .writing-cards {
      grid-template-columns: 1fr;
      gap: 1.25rem;
      padding-bottom: 1.5rem;
      min-width: 0;
    }
    .writing-card {
      min-width: 0;
      border-radius: 2px;
    }
    .writing-card-text {
      padding: 1.125rem 1rem 0.875rem;
      background: transparent;
    }
    .writing-card-title {
      font-size: 1rem;
      line-height: 1.4;
    }
    .writing-card-subtitle {
      font-size: 0.875rem;
      line-height: 1.45;
    }
    .writing-card-meta {
      font-size: 0.8125rem;
      margin-top: 0.2rem;
    }
    .writing-card-image-wrap {
      aspect-ratio: 4 / 3;
    }
  }
  @media (max-width: 768px) and (prefers-color-scheme: dark) {
    .writing-card-text {
      background: transparent;
    }
  }
</style>
