---
import BaseLayout from '../../components/layout/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { externalArticles } from '../../data/externalArticles';
import { forthcomingArticles } from '../../data/forthcomingArticles';

const posts = (await getCollection('writing')).sort(
  (a, b) => new Date(b.data.pubDate ?? 0).getTime() - new Date(a.data.pubDate ?? 0).getTime()
);
---

<BaseLayout
  title="Writing"
  description="Essays and notes."
  mycelium="subtle"
>
  <header class="writing-index-header container">
    <h1>Writing</h1>
  </header>
  <ul class="post-list">
    {externalArticles.map((article) => (
      article.image ? (
        <li class="post-item post-item--fullscreen">
          <a href={`/writing/${article.slug}`} class="writing-screen-link">
            <span class="writing-screen-bg">
              <img
                src={article.image}
                alt=""
                class="writing-screen-img"
                style={article.imagePosition ? { objectPosition: article.imagePosition } : undefined}
              />
              <span class="writing-screen-overlay" aria-hidden="true" />
            </span>
            <span class="writing-screen-text">
              <span class="writing-screen-title-zh">{article.title}</span>
              {article.titleEn && (
                <span class="writing-screen-title-en">{article.titleEn}</span>
              )}
              {article.sourceLine && (
                <span class="writing-screen-status">{article.sourceLine}</span>
              )}
            </span>
          </a>
        </li>
      ) : (
        <li class="post-item">
          <div class="container">
            <div class="post-external-row">
              <a
                href={`/writing/${article.slug}`}
                class="post-link post-link--external"
              >
                <div class="post-entry post-entry--external">
                  <span class="post-title-zh">{article.title}</span>
                  {article.titleEn && (
                    <span class="post-title-en">{article.titleEn}</span>
                  )}
                  {article.sourceLine && <span class="post-status">{article.sourceLine}</span>}
                </div>
              </a>
            </div>
          </div>
        </li>
      )
    ))}
    {forthcomingArticles.map((article) => (
      <li class="post-item">
        <div class="container">
          <a href={`/writing/${article.slug}`} class="post-link post-link--forthcoming">
            <div class="post-entry post-entry--forthcoming">
              <span class="post-title-zh">{article.titleZh}</span>
              <span class="post-title-en">{article.titleEn}</span>
              <span class="post-status">{article.status}</span>
            </div>
          </a>
        </div>
      </li>
    ))}
    {posts.map((post) => (
      <li class="post-item">
        <div class="container">
          <a href={`/writing/${post.slug}`} class="post-link">
            <span class="post-title">{post.data.title}</span>
            {post.data.pubDate && (
              <time class="post-date" datetime={new Date(post.data.pubDate).toISOString()}>
                {new Date(post.data.pubDate).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
              </time>
            )}
          </a>
          {post.data.description && <p class="post-desc">{post.data.description}</p>}
        </div>
      </li>
    ))}
  </ul>
</BaseLayout>

<style>
  .writing-index-header {
    margin-bottom: 0;
  }
  .writing-index-header h1 {
    margin-bottom: 0.5rem;
  }
  .subtitle {
    color: var(--color-text-muted);
  }
  .post-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .post-item {
    border-bottom: 1px solid var(--color-mist);
  }
  .post-item:not(.post-item--fullscreen) {
    padding: 1.25rem 0;
  }
  /* 全屏图块：每张图占满一屏，尺寸一致，适当裁剪，文字叠在图片上方 */
  .post-item--fullscreen {
    height: 100vh;
    min-height: 320px;
    padding: 0;
    border-bottom: none;
  }
  .writing-screen-link {
    display: block;
    position: relative;
    width: 100%;
    height: 100%;
    color: inherit;
    text-decoration: none;
  }
  .writing-screen-bg {
    position: absolute;
    inset: 0;
  }
  .writing-screen-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .writing-screen-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.35);
    pointer-events: none;
  }
  .writing-screen-text {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    padding: clamp(2rem, 6vw, 4rem) 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    max-width: 1200px;
    margin: 0 auto;
    box-sizing: border-box;
  }
  .writing-screen-title-zh {
    font-size: clamp(1.5rem, 4vw, 2.25rem);
    font-weight: 600;
    color: #fff;
    line-height: 1.3;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.4);
  }
  .writing-screen-title-en {
    font-size: clamp(1rem, 2.5vw, 1.35rem);
    font-weight: 500;
    color: rgba(255, 255, 255, 0.92);
    line-height: 1.4;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.3);
  }
  .writing-screen-status {
    font-size: clamp(0.875rem, 2vw, 1rem);
    color: rgba(255, 255, 255, 0.8);
    margin-top: 0.25rem;
    text-shadow: 0 1px 1px rgba(0, 0, 0, 0.3);
  }
  .post-external-row {
    display: flex;
    align-items: flex-start;
    gap: 1.75rem;
  }
  .post-link {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.75rem;
    color: var(--color-text);
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .post-link:hover {
    color: var(--color-accent);
    text-decoration: underline;
  }
  .post-link--external,
  .post-link--forthcoming {
    color: var(--color-text);
    font-weight: 600;
  }
  .post-link--external:hover,
  .post-link--forthcoming:hover {
    color: var(--color-accent-hover);
    text-decoration: underline;
  }
  .post-entry--external,
  .post-entry--forthcoming {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .post-entry--external .post-status {
    font-size: 0.8125rem;
    color: var(--color-text-soft);
    margin-top: 0.15rem;
  }
  .post-entry--external .post-title-zh,
  .post-entry--forthcoming .post-title-zh {
    display: block;
    color: var(--color-text);
    font-weight: 600;
  }
  .post-entry--external .post-title-en,
  .post-entry--forthcoming .post-title-en {
    display: block;
    font-size: 0.9375rem;
    color: var(--color-text-muted);
  }
  .post-entry--forthcoming .post-status {
    font-size: 0.8125rem;
    color: var(--color-text-soft);
    margin-top: 0.15rem;
  }
  .post-title {
    font-weight: 500;
  }
  .post-date {
    font-size: 0.875rem;
    color: var(--color-text-soft);
  }
  .post-desc {
    margin: 0.35rem 0 0;
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    line-height: 1.5;
  }
  @media (max-width: 768px) {
    .post-external-row {
      flex-direction: column;
      gap: 1rem;
    }
    .writing-screen-text {
      padding-left: 1rem;
      padding-right: 1rem;
    }
  }
</style>
