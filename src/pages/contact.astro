---
import BaseLayout from '../components/layout/BaseLayout.astro';
---

<BaseLayout
  title="Contact — Alexis Liao"
  description="Email, WeChat public account 河与树, Instagram."
  mycelium="none"
>
  <div class="container contact-page">
    <section class="contact-content">
      <h1>Contact</h1>
      <ul class="contact-links">
        <li><span class="contact-label">Email：</span><a href="mailto:alexisprotopia@gmail.com">alexisprotopia@gmail.com</a></li>
        <li><span class="contact-label">微信公众号：</span><a href="https://mp.weixin.qq.com/s/sO-pa_9-Ccq2rV4cnp8H8A" target="_blank" rel="noopener noreferrer">河与树</a></li>
        <li><span class="contact-label">Ins：</span><a href="https://instagram.com/alexisprotopia" target="_blank" rel="noopener noreferrer">alexisprotopia</a></li>
      </ul>
    </section>
  </div>
</BaseLayout>

<style>
  .contact-page {
    padding-top: 1rem;
  }
  .contact-content {
    padding: 2rem 0 4rem;
    line-height: 1.75;
    max-width: 28rem;
    margin-left: auto;
    text-align: right;
  }
  .contact-content h1 {
    margin-bottom: 0.5rem;
  }
  .contact-lead {
    color: var(--color-text-muted);
    margin-bottom: 2rem;
    font-size: 0.9375rem;
  }
  .contact-links {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .contact-links li {
    margin-bottom: 0.35rem;
  }
  .contact-label {
    font-size: 0.9rem;
    color: var(--color-text-soft);
    margin-right: 0.4rem;
  }
  .contact-links a {
    display: inline;
    padding: 0;
    color: var(--color-accent);
    text-decoration: none;
    font-size: 1rem;
    line-height: 1.6;
    transition: color 0.2s ease, text-decoration-color 0.2s ease;
  }
  .contact-links a:hover {
    color: var(--color-accent-hover);
    text-decoration: underline;
    text-decoration-color: rgba(61, 107, 94, 0.4);
  }
</style>
