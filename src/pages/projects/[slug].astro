---
import BaseLayout from '../../components/layout/BaseLayout.astro';
import { projects } from '../../data/projects';

export async function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { id: project.id },
  }));
}

interface Props {
  id: string;
}

const { id } = Astro.props as Props;
const project = projects.find((p) => p.id === id);
---

{project ? (
  <BaseLayout
    title={`${project.title} — Projects`}
    description={project.shortDescription}
    mycelium="subtle"
  >
    <article class="container reading">
      <header class="project-header">
        <h1>
          {project.href ? (
            <a href={project.href} target="_blank" rel="noopener noreferrer">{project.title}</a>
          ) : (
            project.title
          )}
        </h1>
        {project.href && (
          <p class="project-site">
            <a href={project.href} target="_blank" rel="noopener noreferrer">{project.href.replace(/^https?:\/\//, '')}</a>
          </p>
        )}
        <p class="project-intro">
          {project.shortDescription}
          {project.descriptionEn && (
            <>
              <br />
              <span class="project-intro-en">{project.descriptionEn}</span>
            </>
          )}
        </p>
      </header>

      {(project.longDescriptionZh || project.longDescriptionEn) && (
        <section aria-label="About the project">
          {project.longDescriptionZh && <p lang="zh">{project.longDescriptionZh}</p>}
          {project.longDescriptionEn && <p lang="en">{project.longDescriptionEn}</p>}
          {project.sourceUrl && (
            <p><a href={project.sourceUrl} target="_blank" rel="noopener noreferrer">项目介绍来源 · Project reference</a></p>
          )}
        </section>
      )}

      <p class="back-link">
        <a href="/projects">← Back to Projects</a>
      </p>
    </article>
  </BaseLayout>
) : (
  <BaseLayout title="Project not found" mycelium="none">
    <div class="container reading">
      <p>Project not found.</p>
      <p class="back-link">
        <a href="/projects">← Back to Projects</a>
      </p>
    </div>
  </BaseLayout>
)}

<style>
  .project-header {
    margin-bottom: 2.5rem;
  }
  .project-header h1 a {
    color: var(--color-text);
  }
  .project-header h1 a:hover {
    color: var(--color-accent);
  }
  .project-site {
    margin: 0 0 0.75rem;
    font-size: 0.95rem;
  }
  .project-site a {
    color: var(--color-text-soft);
  }
  .project-site a:hover {
    color: var(--color-accent);
  }
  .project-intro {
    color: var(--color-text-muted);
  }
  .project-intro-en {
    font-size: 0.95rem;
    color: var(--color-text-soft);
  }
  section {
    margin-top: 2rem;
  }
  .back-link {
    margin-top: 3rem;
    font-size: 0.9rem;
  }
  .back-link a {
    color: var(--color-text-soft);
  }
  .back-link a:hover {
    color: var(--color-accent);
  }
</style>

