---
import BaseLayout from '../components/layout/BaseLayout.astro';
---

<BaseLayout
  title="Resources — Alexis 智立"
  description="Resources and references."
  mycelium="subtle"
>
  <div class="container">
    <header class="resources-header">
      <h1 class="reveal-item" data-reveal="title">Resources</h1>
      <p class="resources-intro reveal-item" data-reveal="body">内容稍后补充。Content to be added.</p>
    </header>
  </div>
</BaseLayout>

<style>
  .resources-header {
    padding: 0.5rem 0 3rem;
  }
  .resources-header h1 {
    margin-bottom: 0.5rem;
  }
  .resources-intro {
    color: var(--color-text-muted);
    line-height: 1.7;
    margin: 0;
  }
</style>
