---
import BaseLayout from '../components/layout/BaseLayout.astro';
---

<BaseLayout
  title="Activities — Alexis Liao"
  description="Selected activities: study tours, exhibitions, salons."
  mycelium="subtle"
>
  <div class="container">
    <header class="activities-header">
      <h1 class="reveal-item" data-reveal="title">Activities</h1>
      <p class="activities-intro activities-intro-zh reveal-item" data-reveal="body">部分活动</p>
      <p class="activities-intro activities-intro-en reveal-item" data-reveal="body">Selected Activities</p>
    </header>

    <h2 class="activities-category reveal-item" data-reveal="body">游学 · Study Tours</h2>
    <ul class="activity-list">
      <li class="activity-item reveal-item" data-reveal="body">
        <details class="activity-details">
          <summary class="activity-summary">
            <p class="activity-title-zh"><a href="https://mp.weixin.qq.com/s/nZ6iMb04DdmJVH1gqcQziQ" target="_blank" rel="noopener noreferrer" onclick="event.stopPropagation()">共识之路——欧洲共识社区访问</a></p>
            <p class="activity-title-en"><a href="https://mp.weixin.qq.com/s/nZ6iMb04DdmJVH1gqcQziQ" target="_blank" rel="noopener noreferrer" onclick="event.stopPropagation()">The Path of Consensus — Visits to European Consensus Communities</a></p>
            <p class="activity-org">家园计划 · The Home Project</p>
          </summary>
          <div class="activity-body">
            <p><a href="https://mp.weixin.qq.com/s/nZ6iMb04DdmJVH1gqcQziQ" target="_blank" rel="noopener noreferrer">相关文章 · Related article (微信)</a></p>
          </div>
        </details>
      </li>
    </ul>

    <h2 class="activities-category reveal-item" data-reveal="body">展览 · Exhibitions</h2>
    <ul class="activity-list">
      <li class="activity-item reveal-item" data-reveal="body">
        <details class="activity-details">
          <summary class="activity-summary">
            <p class="activity-title-zh"><a href="https://mp.weixin.qq.com/s/u1tmkgwR9eMbvUOTm3Vpeg" target="_blank" rel="noopener noreferrer" onclick="event.stopPropagation()">池化：普罗托邦研究文献展</a></p>
            <p class="activity-title-en"><a href="https://mp.weixin.qq.com/s/u1tmkgwR9eMbvUOTm3Vpeg" target="_blank" rel="noopener noreferrer" onclick="event.stopPropagation()">Pooling: A Research Literature Exhibition on Prototopia</a></p>
            <p class="activity-org">普罗托邦 · Prototopia</p>
          </summary>
          <div class="activity-body">
            <p><a href="https://mp.weixin.qq.com/s/u1tmkgwR9eMbvUOTm3Vpeg" target="_blank" rel="noopener noreferrer">相关文章 · Related article (微信)</a></p>
          </div>
        </details>
      </li>
    </ul>

    <h2 class="activities-category reveal-item" data-reveal="body">沙龙 · Salons</h2>
    <ul class="activity-list">
      <li class="activity-item reveal-item" data-reveal="body">
        <details class="activity-details">
          <summary class="activity-summary">
            <p class="activity-title-zh"><a href="https://mp.weixin.qq.com/s/UEOVT1x8RMnF6O9Um6-yYw" target="_blank" rel="noopener noreferrer" onclick="event.stopPropagation()">浮城圆桌：知合 NEXUS 上海年聚系列沙龙</a></p>
            <p class="activity-title-en"><a href="https://mp.weixin.qq.com/s/UEOVT1x8RMnF6O9Um6-yYw" target="_blank" rel="noopener noreferrer" onclick="event.stopPropagation()">Floating City Roundtable: Zhihé NEXUS Shanghai Annual Salon Series</a></p>
            <p class="activity-org">知合 NEXUS · NEXUS</p>
          </summary>
          <div class="activity-body">
            <p><a href="https://mp.weixin.qq.com/s/UEOVT1x8RMnF6O9Um6-yYw" target="_blank" rel="noopener noreferrer">相关文章 · Related article (微信)</a></p>
          </div>
        </details>
      </li>
      <li class="activity-item reveal-item" data-reveal="body">
        <details class="activity-details">
          <summary class="activity-summary">
            <p class="activity-title-zh"><a href="https://mp.weixin.qq.com/s/bkq3axmQ8wcUPfhaXpjLiQ" target="_blank" rel="noopener noreferrer" onclick="event.stopPropagation()">In-between 共居生活系列沙龙</a></p>
            <p class="activity-title-en"><a href="https://mp.weixin.qq.com/s/bkq3axmQ8wcUPfhaXpjLiQ" target="_blank" rel="noopener noreferrer" onclick="event.stopPropagation()">In-Between Co-living Life Salon Series</a></p>
            <p class="activity-org">Dweller</p>
          </summary>
          <div class="activity-body">
            <p><a href="https://mp.weixin.qq.com/s/bkq3axmQ8wcUPfhaXpjLiQ" target="_blank" rel="noopener noreferrer">相关文章 · Related article (微信)</a></p>
          </div>
        </details>
      </li>
    </ul>
  </div>
</BaseLayout>

<style>
  .activities-header {
    margin-bottom: 2.5rem;
  }
  .activities-header h1 {
    margin-bottom: 0.5rem;
  }
  .activities-intro {
    color: var(--color-text-muted);
    line-height: 1.7;
    max-width: 48rem;
    margin: 0 0 0.25rem;
  }
  .activities-intro-en {
    font-size: 0.95rem;
    color: var(--color-text-soft);
  }
  .activities-category {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--color-text);
    letter-spacing: 0.04em;
    margin: 2rem 0 0.75rem;
  }
  .activity-list {
    list-style: none;
    padding: 0;
    margin: 0 0 1.5rem;
  }
  .activity-item {
    padding: 0;
    border-bottom: 1px solid var(--color-mist);
  }
  .activity-item:last-child {
    border-bottom: none;
  }
  .activity-details {
    padding: 1rem 0;
  }
  .activity-summary {
    list-style: none;
    cursor: pointer;
    outline: none;
  }
  .activity-summary::-webkit-details-marker {
    display: none;
  }
  .activity-summary::marker {
    display: none;
  }
  .activity-summary::before {
    content: '';
    display: inline-block;
    width: 0.5rem;
    height: 0.5rem;
    margin-right: 0.5rem;
    border-right: 2px solid var(--color-text-soft);
    border-bottom: 2px solid var(--color-text-soft);
    transform: rotate(45deg);
    vertical-align: 0.2rem;
    transition: transform 0.2s ease;
  }
  .activity-details[open] .activity-summary::before {
    transform: rotate(-135deg);
    vertical-align: 0.05rem;
  }
  .activity-title-zh {
    font-weight: 500;
    color: var(--color-text);
    margin: 0 0 0.2rem;
    max-width: 48rem;
  }
  .activity-title-en {
    font-size: 0.95rem;
    color: var(--color-text-soft);
    margin: 0 0 0.35rem;
    max-width: 48rem;
  }
  .activity-org {
    font-size: 0.8125rem;
    color: var(--color-text-soft);
    margin: 0;
  }
  .activity-body {
    margin-top: 1rem;
    padding: 1rem 0 0;
    border-top: 1px solid var(--color-mist);
    max-width: 48rem;
  }
  .activity-body p {
    color: var(--color-text-muted);
    line-height: 1.7;
    margin: 0 0 0.75rem;
  }
  .activity-body p:last-child {
    margin-bottom: 0;
  }
  .activity-placeholder {
    font-size: 0.95rem;
    color: var(--color-text-soft);
  }
</style>
